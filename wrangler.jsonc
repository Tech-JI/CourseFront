{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coursefront",
  "main": "worker.js",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
